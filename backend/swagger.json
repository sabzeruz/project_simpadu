{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "SIMPADU API",
    "description": "Dokumentasi API SIMPADU"
  },
  "host": "localhost:4000",
  "basePath": "/api",
  "schemes": [
    "http"
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login berhasil"
          },
          "401": {
            "description": "Username atau password salah"
          }
        }
      }
    },
    "/pegawai": {
      "get": {
        "summary": "List semua pegawai (admin only)",
        "tags": [
          "Pegawai"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar pegawai"
          }
        }
      },
      "post": {
        "summary": "Tambah pegawai (admin only)",
        "tags": [
          "Pegawai"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PegawaiInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Pegawai berhasil ditambahkan"
          }
        }
      }
    },
    "/pegawai/{id}": {
      "get": {
        "summary": "Detail pegawai (admin only)",
        "tags": [
          "Pegawai"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Detail pegawai"
          },
          "404": {
            "description": "Pegawai tidak ditemukan"
          }
        }
      },
      "put": {
        "summary": "Update pegawai (admin only)",
        "tags": [
          "Pegawai"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PegawaiInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pegawai berhasil diupdate"
          }
        }
      },
      "delete": {
        "summary": "Hapus pegawai (admin only)",
        "tags": [
          "Pegawai"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Pegawai berhasil dihapus"
          }
        }
      }
    },
    "/pegawai/profile/me": {
      "get": {
        "summary": "Profile pegawai login",
        "tags": [
          "Pegawai"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Data profil pegawai"
          }
        }
      }
    },
    "/pegawai-ringkas": {
      "get": {
        "summary": "List ringkas pegawai",
        "tags": [
          "Pegawai"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar ringkas pegawai"
          }
        }
      }
    },
    "/presensi": {
      "get": {
        "summary": "List presensi (bisa filter by id_pegawai)",
        "tags": [
          "Presensi"
        ],
        "parameters": [
          {
            "name": "id_pegawai",
            "in": "query",
            "required": false,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar presensi"
          }
        }
      },
      "post": {
        "summary": "Tambah presensi",
        "tags": [
          "Presensi"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PresensiInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Presensi berhasil"
          }
        }
      }
    },
    "/presensi/{id}": {
      "get": {
        "summary": "Detail presensi by id",
        "tags": [
          "Presensi"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Detail presensi"
          },
          "404": {
            "description": "Data tidak ditemukan"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "definitions": {
    "PegawaiInput": {
      "type": "object",
      "properties": {
        "nama_pegawai": {
          "type": "string"
        },
        "nip": {
          "type": "string"
        },
        "nidn": {
          "type": "string"
        },
        "nuptk": {
          "type": "string"
        },
        "alamat": {
          "type": "string"
        },
        "foto": {
          "type": "string"
        }
      }
    },
    "PresensiInput": {
      "type": "object",
      "properties": {
        "id_pegawai": {
          "type": "integer"
        },
        "tanggal": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "Hadir",
            "Pulang"
          ]
        },
        "jam_masuk": {
          "type": "string"
        },
        "jam_keluar": {
          "type": "string"
        }
      }
    }
  }
}