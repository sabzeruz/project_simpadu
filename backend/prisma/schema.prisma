generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model simpeg_pegawai {
  id_pegawai   Int        @id @default(autoincrement()) @db.SmallInt
  nama_pegawai String     @db.VarChar(60)
  nidn         String     @db.Char(10)
  nip          String     @db.Char(18)
  nuptk        String     @db.Char(16)
  alamat       String?    @db.VarChar(255)
  foto         String?    @default("blm_ada_foto.jpg") @db.VarChar(255)
  presensi     presensi[]
}

model user_level {
  id_level   Int    @id @default(autoincrement()) @db.UnsignedTinyInt
  nama_level String @db.Char(20)
}

model users {
  id_user      Int          @id @default(autoincrement())
  level        Int          @db.SmallInt
  username     String       @db.Char(35)
  password     String?      @db.VarChar(100)
  nama_lengkap String?      @db.VarChar(100)
  email        String?      @db.VarChar(100)
  no_telp      String?      @db.VarChar(100)
  aktif        users_aktif
  blokir       users_blokir @default(N)
  ket          String?      @db.VarChar(255)
}

model presensi {
  id_presensi     Int             @id @default(autoincrement())
  id_pegawai      Int             @db.SmallInt
  tanggal         DateTime        @db.Date
  status          presensi_status
  jam_masuk       DateTime?       @db.Time(0)
  jam_keluar      DateTime?       @db.Time(0)
  keterangan_izin String?         @db.Text
  simpeg_pegawai  simpeg_pegawai  @relation(fields: [id_pegawai], references: [id_pegawai], onDelete: NoAction, onUpdate: NoAction, map: "presensi_ibfk_1")

  @@index([id_pegawai], map: "id_pegawai")
}

enum users_blokir {
  Y
  N
}

enum users_aktif {
  Y
  N
}

enum presensi_status {
  Hadir
  Pulang
  Izin
}
